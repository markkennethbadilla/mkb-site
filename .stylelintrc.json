{
  "plugins": ["stylelint-declaration-strict-value"],
  "rules": {
    "scale-unlimited/declaration-strict-value": [
      ["/color$/", "background", "font-family", "font", "fill", "stroke"],
      { "ignoreValues": ["currentColor", "currentcolor", "transparent", "inherit", "initial", "unset", "none"] }
    ]
  }
}
