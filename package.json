{
  "name": "porfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-resume.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:worker": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "links": "lychee --offline --no-progress --exclude /api/ --root-dir out out",
    "check:full": "bun run gate",
    "probe:guide": "node scripts/probe-guide.mjs",
    "probe:demos": "node --test tests/probe-demos.mjs",
    "bench:guide": "node scripts/bench-guide.mjs",
    "seed": "node scripts/gen-seed.mjs",
    "cf": "node scripts/cf.mjs",
    "deploy": "bun run gate && node scripts/cf.mjs d1 migrations apply mkb-site-demo --remote && node scripts/cf.mjs d1 migrations apply mkb-site-warehouse --remote && node scripts/cf.mjs deploy",
    "icons": "node scripts/gen-skill-icons.mjs",
    "favicon": "node scripts/gen-favicon.mjs",
    "gate": "TURBO_TELEMETRY_DISABLED=1 NEXT_TELEMETRY_DISABLED=1 turbo run lint typecheck test test:worker migrate:check links e2e fuzz evals --output-logs=errors-only",
    "maint": "depcruise --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json src scripts tests worker && knip --no-progress && jscpd src scripts tests worker --silent && eslint -c eslint.maint.config.mjs --suppressions-location eslint-maint-suppressions.json src scripts tests worker --cache --cache-location node_modules/.cache/eslint-maint",
    "links:outside": "lychee --no-progress --exclude /api/ --exclude linkedin.com --root-dir out out",
    "migrate:check": "node scripts/check-migrations.mjs",
    "backup": "node scripts/backup-d1.mjs",
    "scheduled": "TURBO_TELEMETRY_DISABLED=1 turbo run e2e:webkit links:outside redteam zap backup --force --continue --output-logs=errors-only",
    "e2e": "playwright test --project=chromium",
    "e2e:webkit": "playwright test --project=webkit",
    "fuzz": "playwright test --project=fuzz",
    "zap": "playwright test --project=zap",
    "evals": "node scripts/promptfoo.mjs",
    "redteam": "node scripts/promptfoo.mjs redteam"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.94",
    "@content-collections/mdx": "0.2.2",
    "@floating-ui/react-dom": "2.1.6",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-slot": "1.2.4",
    "@tailwindcss/postcss": "4.1.18",
    "ai": "7.0.181",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "content-collections": "0.2.1",
    "escape-html": "1.0.3",
    "lenis": "1.3.25",
    "lucide-react": "0.562.0",
    "motion": "12.24.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "posthog-js": "1.453.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remark-gfm": "4.0.1",
    "shiki": "3.20.0",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.1.18",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vitest-plugin": "1.9.0",
    "@content-collections/core": "0.15.3",
    "@content-collections/next": "0.2.11",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/typography": "0.5.19",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "dependency-cruiser": "18.8.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "fontkit": "2.0.4",
    "jscpd": "5.4.3",
    "jsonresume-theme-stackoverflow": "3.3.0",
    "knip": "6.47.0",
    "postcss": "8.5.33",
    "promptfoo": "0.126.0",
    "simple-icons": "16.28.0",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.52.0",
    "vitest": "4.1.12",
    "wrangler": "4.166.0"
  },
  "overrides": {
    "undici@7.29.0": "7.30.2",
    "minimatch@3.1.2": "3.1.5",
    "minimatch@9.0.5": "9.0.9",
    "brace-expansion@1.1.12": "1.1.22",
    "brace-expansion@2.0.2": "2.1.8",
    "picomatch@2.3.1": "2.3.2",
    "picomatch@4.0.3": "4.0.7",
    "js-yaml@3.14.2": "3.15.2",
    "js-yaml@4.1.1": "4.3.2",
    "nanoid@3.3.11": "3.3.20",
    "postcss@8.5.6": "8.5.33",
    "postcss@8.5.23": "8.5.33",
    "yaml@2.8.2": "2.9.1",
    "flatted": "3.4.4",
    "defu": "6.1.7",
    "ajv@6.12.6": "6.15.0",
    "source-map-js@1.2.1": "1.2.4",
    "baseline-browser-mapping@2.9.11": "2.11.39",
    "browserslist@4.28.1": "4.29.6",
    "zod@4.6.6": "4.6.7",
    "@babel/core@7.28.5": "7.29.13",
    "toml": "4.3.0",
    "uuid": "11.1.1",
    "@humanfs/node": "0.17.0",
    "postcss-selector-parser@6.0.10": "6.1.6",
    "eslint-plugin-react-hooks": "7.0.1"
  }
}
