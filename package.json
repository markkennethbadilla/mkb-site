{
  "name": "porfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:worker": "vitest run",
    "test:e2e": "playwright test",
    "links": "linkinator ./out --recurse --retry --timeout 15000 --status-code 403:warn --status-code 429:warn",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:worker",
    "check:full": "npm run check && npm run test:e2e && npm run links",
    "probe:guide": "node scripts/probe-guide.mjs",
    "probe:demos": "node --test tests/probe-demos.mjs",
    "bench:guide": "node scripts/bench-guide.mjs",
    "seed": "node scripts/gen-seed.mjs",
    "cf": "node scripts/cf.mjs",
    "deploy": "bun run build && node scripts/cf.mjs deploy",
    "icons": "node scripts/gen-skill-icons.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.22",
    "@content-collections/mdx": "0.2.2",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tailwindcss/postcss": "4.1.18",
    "ai": "7.0.51",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "content-collections": "0.2.1",
    "lenis": "1.3.25",
    "lucide-react": "0.562.0",
    "motion": "12.24.0",
    "next": "16.1.1",
    "next-themes": "0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "3.20.0",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.1.18",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.0.0",
    "@content-collections/core": "0.13.1",
    "@content-collections/next": "0.2.10",
    "@playwright/test": "1.62.1",
    "@tailwindcss/typography": "0.5.19",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "csv-parse": "7.0.2",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.1",
    "linkinator": "8.0.4",
    "postcss": "8.5.6",
    "simple-icons": "16.28.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.118.0"
  }
}
