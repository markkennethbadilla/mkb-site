{
  "openapi": "3.1.0",
  "info": {
    "title": "mkb-site API (worker/index.ts)",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Guide": {
        "type": "object",
        "properties": {
          "section": {
            "type": [
              "string",
              "null"
            ]
          },
          "answer": {
            "type": "string"
          },
          "declined": {
            "type": "boolean"
          },
          "degraded": {
            "type": [
              "string",
              "boolean"
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "ms": {
            "type": "number"
          },
          "cached": {
            "type": "boolean"
          }
        },
        "required": [
          "answer",
          "steps"
        ]
      },
      "AgentOut": {
        "type": "object",
        "properties": {
          "degraded": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "cascade": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/guide": {
      "post": {
        "summary": "One guide question: a section, an answer or a decline. Records the body first.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "question"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Answer or degraded notice",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Guide"
                }
              }
            }
          },
          "400": {
            "description": "Invalid question",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent": {
      "post": {
        "summary": "One agent attempt. Records the body first.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "instruction": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  "previous": {
                    "type": "string",
                    "maxLength": 6000
                  },
                  "gateFeedback": {
                    "type": "string",
                    "maxLength": 4000
                  }
                },
                "required": [
                  "instruction"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result or degraded notice",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentOut"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/models": {
      "get": {
        "summary": "Free-model chain, limiter status and budget spend.",
        "responses": {
          "200": {
            "description": "Status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "discoveredFree": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "finalFallback": {
                      "type": "string"
                    },
                    "hasKey": {
                      "type": "boolean"
                    },
                    "budget": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "discoveredFree",
                    "finalFallback",
                    "hasKey",
                    "budget"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/demos/{slug}/state": {
      "get": {
        "summary": "A room state read that needs a run id. Records the body first.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "ledger-under-fire",
                "split-brain"
              ]
            }
          },
          {
            "name": "runId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Run status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad or missing run id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Wrong method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Run limiter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
