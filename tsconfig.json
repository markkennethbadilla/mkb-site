{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "content-collections": [
        "./.content-collections/generated"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // The Worker is checked, but as its own program: worker/tsconfig.json, run by
    // `bun run check`. It cannot share this one, because the Workers runtime and
    // the browser both define Request, Response and fetch with different types.
    // Excluded here so the site is not checked against a runtime it never sees;
    // for months this line was the only entry and nothing checked the Worker at
    // all.
    "worker",
    "worker-configuration.d.ts"
  ]
}