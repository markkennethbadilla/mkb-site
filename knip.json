{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.mjs",
    "promptfooconfig.mjs",
    "evals/*.mjs"
  ],
  "ignore": [
    "content-collections.ts",
    "src/mdx-components.tsx",
    "src/lib/gates.ts",
    "src/components/demo/stats-bar.tsx",
    "src/components/mdx/code-block.tsx",
    "src/components/mdx/media-container.tsx",
    "src/components/ui/badge.tsx"
  ],
  "ignoreDependencies": [
    "@content-collections/mdx",
    "content-collections",
    "remark-gfm",
    "shiki",
    "@fontsource/geist-sans",
    "vite",
    "promptfoo"
  ],
  "ignoreIssues": {
    "src/lib/spend-cap.ts": [
      "exports"
    ],
    "src/lib/utils.ts": [
      "exports"
    ],
    "worker/guide-tools.ts": [
      "exports"
    ],
    "src/components/ui/button.tsx": [
      "exports",
      "types"
    ],
    "src/components/demos/shell/telemetry.tsx": [
      "exports",
      "duplicates"
    ],
    "src/lib/demos/fetch-json.ts": [
      "exports"
    ],
    "src/lib/demos/registry.ts": [
      "types"
    ],
    "src/components/demos/rooms/ledger-under-fire/types.ts": [
      "types"
    ],
    "src/components/demos/rooms/split-brain/types.ts": [
      "types"
    ]
  },
  "ignoreBinaries": [
    "uvx",
    "wsl",
    "lychee"
  ]
}
